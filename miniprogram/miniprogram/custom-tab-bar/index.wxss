.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: flex-start;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 10rpx 12rpx env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 -10rpx 30rpx rgba(33, 44, 52, .08);
  z-index: 999;
}

.tab-item {
  flex: 1;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #91969b;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.55;
  transition: opacity .2s;
}

.tab-item.active .tab-icon {
  opacity: 1;
}

.tab-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #91969b;
  line-height: 1.2;
}

.tab-item.active .tab-text {
  color: #111418;
  font-weight: 700;
}

.tab-center {
  flex: 1;
  height: 92rpx;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.center-btn {
  width: 104rpx;
  height: 104rpx;
  margin-top: -34rpx;
  border-radius: 50%;
  border: 6rpx solid #ffffff;
  box-sizing: border-box;
  background: #ffe500;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, .14);
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #111418;
  letter-spacing: 1rpx;
}