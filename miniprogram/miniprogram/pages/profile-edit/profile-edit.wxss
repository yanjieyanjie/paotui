page {
  background: #f7f8fa;
}

.page {
  padding: 24rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.avatar-card {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07c160, #10b981);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-right {
  margin-left: 24rpx;
}

.avatar-tip {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.avatar-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.form {
  margin-top: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.form-picker {
  flex: 1;
}

.form-picker-value {
  font-size: 28rpx;
  color: #1f2329;
}

.list-state {
  text-align: center;
  color: #999999;
  padding: 40rpx 0;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #07c160, #10b981);
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.submit-btn[disabled] {
  opacity: 0.7;
}

.switch-btn {
  margin-top: 24rpx;
  background: #ffffff;
  color: #576b95;
  border: 1rpx solid #d9dde3;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.switch-btn[disabled] {
  opacity: 0.7;
}