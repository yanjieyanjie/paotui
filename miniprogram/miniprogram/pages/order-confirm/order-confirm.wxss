.page {
  padding: 24rpx 24rpx 200rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(90, 160, 220, 0.1);
}

.info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.info-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

.info-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 26rpx;
}

.row-label {
  color: #999999;
  flex-shrink: 0;
}

.row-value {
  color: #333333;
  margin-left: 24rpx;
  text-align: right;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.amount-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #bbbbbb;
}

.pay-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 16rpx 24rpx calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 24rpx rgba(90, 160, 220, 0.08);
}

.pay-total {
  font-size: 28rpx;
  color: #333333;
  margin-right: 24rpx;
}

.pay-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #ff4d4f;
}

.pay-btn {
  margin: 0;
  padding: 0 56rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #07c160;
  border-radius: 44rpx;
}

.pay-btn::after {
  border: none;
}

.pay-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.pay-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(32rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.sheet-amount {
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #333333;
  margin-top: 24rpx;
}

.sheet-method {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333333;
}

.wechat-icon {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #07c160;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 12rpx;
  margin-right: 16rpx;
}

.method-check {
  margin-left: auto;
  color: #07c160;
  font-weight: 700;
}

.sheet-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.sheet-cancel {
  background: #f2f3f5;
  color: #666666;
}

.sheet-ok {
  background: #07c160;
  color: #ffffff;
  font-weight: 600;
}