<view class="page">
  <view class="intro card">
    <view class="intro-icon">🛵</view>
    <view class="intro-title">成为接单员</view>
    <view class="intro-desc">申请通过后即可在「接单大厅」接单，赚取跑腿佣金。</view>
  </view>

  <view class="form card">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <text class="form-label">校区</text>
      <picker class="form-picker" mode="selector" range="{{schools}}" value="{{schoolIndex}}" bindchange="onSchoolChange">
        <view class="form-picker-value">{{schools[schoolIndex]}}</view>
      </picker>
    </view>
  </view>

  <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">提交申请</button>
</view>