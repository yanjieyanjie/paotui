.page {
  min-height: 100vh;
  background: #f7f8fa;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.hero {
  padding: 100rpx 48rpx 80rpx;
  color: #ffffff;
}

.ad-driving {
  background: linear-gradient(135deg, #4facfe 0%, #00c6a7 100%);
}

.ad-training {
  background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
}

.hero-emoji {
  font-size: 120rpx;
  line-height: 1;
}

.hero-title {
  margin-top: 32rpx;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.3;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  opacity: 0.92;
}

.card {
  background: #ffffff;
  margin: -40rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(90, 160, 220, 0.1);
}

.points-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
  margin-bottom: 20rpx;
}

.point-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
}

.point-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

.point-text {
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}

.footer {
  margin: 48rpx 24rpx 0;
}

.cta-btn {
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  background: #07c160;
  color: #ffffff;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 700;
  border: none;
}

.cta-btn::after {
  border: none;
}

.cta-btn-hover {
  opacity: 0.85;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}