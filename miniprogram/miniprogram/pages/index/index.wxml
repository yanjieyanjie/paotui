<view class="page">
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="school-picker" hover-class="school-picker-hover" bindtap="onSchoolTap">
      <text class="loc-icon">📍</text>
      <view class="school-name">{{schoolName}}</view>
      <view class="school-caret">▾</view>
    </view>
  </view>

  <view class="brand" bindtap="goHall">
    <view class="hero-art">
      <view class="sun"></view>
      <view class="cloud cloud-a">☁️</view>
      <view class="cloud cloud-b">☁️</view>
      <view class="rider">🛵</view>
      <view class="runner">🏃</view>
    </view>
    <view class="brand-eyebrow">CAMPUS GO · 校园互助</view>
    <view class="brand-line1">爱工商</view>
    <view class="brand-line2">校园服务平台</view>
  </view>

  <view class="notice">
    <view class="notice-icon">📣</view>
    <text class="notice-text">男寝如需送上楼，请记得备注哦~</text>
  </view>

    <view class="service-panel card">
    <view class="feature-row">
      <view class="feature-card" style="background: #a9eddf;" data-type="express" bindtap="onCardTap">
        <view>
          <text class="feature-name">快递代取</text>
          <text class="feature-action">去下单 ›</text>
        </view>
        <text class="feature-icon">📦</text>
      </view>
      <view class="feature-card" style="background: #ffd47d;" data-type="food" bindtap="onCardTap">
        <view>
          <text class="feature-name">代拿外卖</text>
          <text class="feature-action">去下单 ›</text>
        </view>
        <text class="feature-icon">🍔</text>
      </view>
    </view>

    <view class="service-grid">
      <view class="service-cell" wx:for="{{services}}" wx:key="key" data-name="{{item.name}}" bindtap="onServiceTap">
        <view class="service-icon" style="background: {{item.bg}}">{{item.icon}}</view>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <swiper class="ad-swiper" autoplay="{{true}}" circular="{{true}}" interval="{{3500}}" duration="500" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{ads}}" wx:key="title" bindtap="onAdTap" data-type="{{item.type}}">
      <view class="ad-item {{item.cls}}">
        <view class="ad-emoji">{{item.icon}}</view>
        <view class="ad-text">
          <view class="ad-title">{{item.title}}</view>
          <view class="ad-sub">{{item.sub}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="order-header">
    <text class="order-title">最新订单</text>
    <text class="order-more" bindtap="goHall">查看全部 ›</text>
  </view>

    <view class="list-state" wx:if="{{loading}}">加载中...</view>
  <view class="list-state" wx:if="{{!loading && orders.length === 0}}">暂无订单，去发布一个吧</view>

    <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap" hover-class="order-card-hover">
    <view class="task-head">
      <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view wx:if="{{!item.avatarUrl}}" class="avatar">{{item.avatarText}}</view>
      <text class="service-tag service-{{item.type}}">{{item.typeLabel}}</text>
      <text class="deadline">◷ {{item.deadlineText}}</text>
      <text class="status status-{{item.status}}">{{item.statusLabel}}</text>
    </view>

    <view class="task-copy">
      <text wx:if="{{item.gender && item.gender !== '不限'}}" class="gender">{{item.gender}}</text>
      <text wx:else class="gender unlimited">不限</text>
      <text class="task-title">{{item.title}}</text>
      <text wx:if="{{item.description}}" class="task-desc">{{item.description}}</text>
    </view>

    <view wx:if="{{item.pickup || item.delivery}}" class="route">
      <view wx:if="{{item.pickup}}" class="route-row"><text class="route-icon">📦</text><text>{{item.pickup}}</text></view>
      <view wx:if="{{item.delivery}}" class="route-row"><text class="route-icon">🏁</text><text>{{item.delivery}}</text></view>
    </view>

    <view class="task-foot">
      <view class="reward"><text class="reward-mark">赏</text><text>¥{{item.reward}}</text></view>
      <text class="created">{{item.timeText}}</text>
      <button wx:if="{{item.showAccept}}" class="accept-button" data-id="{{item.id}}" catchtap="onAccept">抢单</button>
      <button wx:if="{{item.showWithdraw}}" class="accept-button mine" data-id="{{item.id}}" catchtap="onCancel">撤回任务</button>
    </view>
  </view>
</view>
