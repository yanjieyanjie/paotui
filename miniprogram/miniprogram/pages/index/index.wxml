<view class="page">
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="school-picker" hover-class="school-picker-hover" bindtap="onSchoolTap">
      <text class="loc-icon">📍</text>
      <view class="school-name">{{schoolName}}</view>
      <view class="school-caret">▾</view>
    </view>
  </view>

  <view class="brand" bindtap="goHall">
    <view class="brand-line1">爱工商</view>
    <view class="brand-line2">校园服务平台</view>
  </view>

  <view class="notice">
    <view class="notice-icon">📣</view>
    <text class="notice-text">男寝如需送上楼，请记得备注哦~</text>
  </view>

  <view class="quick-row">
    <view class="quick-btn" data-type="express" bindtap="onCardTap">
      <view class="quick-icon icon-blue">📦</view>
      <view class="quick-name">快递代取</view>
      <view class="quick-arrow">›</view>
    </view>
    <view class="quick-btn" data-type="food" bindtap="onCardTap">
      <view class="quick-icon icon-orange">🧤</view>
      <view class="quick-name">代拿外卖</view>
      <view class="quick-arrow">›</view>
    </view>
  </view>

  <view class="func-grid">
    <view class="func-item" wx:for="{{services}}" wx:key="key" data-name="{{item.name}}" bindtap="onServiceTap">
      <view class="func-icon" style="background: {{item.bg}};">{{item.icon}}</view>
      <view class="func-name">{{item.name}}</view>
    </view>
  </view>

  <swiper class="ad-swiper" autoplay="{{true}}" circular="{{true}}" interval="{{3500}}" duration="500" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ffffff">
    <swiper-item wx:for="{{ads}}" wx:key="title" bindtap="onAdTap" data-type="{{item.type}}">
      <view class="ad-item {{item.cls}}">
        <view class="ad-emoji">{{item.icon}}</view>
        <view class="ad-text">
          <view class="ad-title">{{item.title}}</view>
          <view class="ad-sub">{{item.sub}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="order-header">
    <text class="order-title">最新订单</text>
    <text class="order-more" bindtap="goHall">查看全部 ›</text>
  </view>

    <view class="list-state" wx:if="{{loading}}">加载中...</view>
  <view class="list-state" wx:if="{{!loading && orders.length === 0}}">暂无订单，去发布一个吧</view>

  <view class="order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onOrderTap" hover-class="order-card-hover">
    <view class="order-head">
      <view class="user-info">
        <image wx:if="{{item.avatarUrl}}" class="user-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:if="{{!item.avatarUrl}}" class="user-avatar">{{item.avatarText}}</view>
        <text class="user-nickname">{{item.creatorName}}</text>
      </view>
      <van-tag color="{{item.tagColor}}" plain>{{item.typeLabel}}</van-tag>
      <view class="deadline">
        <van-icon name="clock-o" size="26" color="#999" />
        <text class="deadline-text">截止 {{item.deadlineText}}</text>
      </view>
      <van-tag type="primary" plain>{{item.statusLabel}}</van-tag>
    </view>
    <view class="order-body">
      <view class="order-item-title">{{item.title}}</view>
      <view class="order-desc" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="loc-row" wx:if="{{item.pickup}}">
        <van-icon name="location-o" size="28" color="#999" />
        <text>{{item.pickup}}</text>
      </view>
      <view class="loc-row" wx:if="{{item.delivery}}">
        <van-icon name="flag-o" size="28" color="#999" />
        <text>{{item.delivery}}</text>
      </view>
    </view>
    <view class="order-foot">
      <view class="reward">
        <text class="reward-label">赏金</text>
        <text class="order-price">¥{{item.reward}}</text>
      </view>
      <view class="publish-time">
        <van-icon name="clock-o" size="24" color="#aaa" />
        <text>发布时间 {{item.timeText}}</text>
      </view>
    </view>
    <view class="order-actions" wx:if="{{item.showAccept}}">
      <van-button size="small" type="primary" round block data-id="{{item.id}}" catchtap="onAccept">抢单</van-button>
    </view>
    <view class="order-actions" wx:if="{{item.showWithdraw}}">
      <van-button size="small" type="danger" plain round block data-id="{{item.id}}" catchtap="onCancel">撤回任务</van-button>
    </view>
  </view>
</view>