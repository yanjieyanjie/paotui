page {
  background: linear-gradient(180deg, #d9f0ff 0%, #f2faff 45%, #ffffff 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx 220rpx;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}


/* 第一行：学校地址栏 */
.top-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding-bottom: 8rpx;
  background: #d9f0ff;
}

.school-picker {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(80, 160, 220, 0.14);
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2329;
}

.loc-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.school-name {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.school-caret {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: #4fa9e8;
}

/* 第二行：品牌广告区（无边框，与背景融为一体，点击跳转接单大厅） */
.brand {
  margin-top: 24rpx;
  padding: 8rpx 8rpx 16rpx;
}

.brand-line1 {
  font-size: 68rpx;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: #2f9de8;
}

.brand-line2 {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #5a6b7a;
  letter-spacing: 10rpx;
}

/* 第三行：公告 */
.notice {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 20rpx 28rpx;
  background: #fff6e3;
  border-radius: 28rpx;
}

.notice-icon {
  font-size: 34rpx;
  line-height: 1;
  margin-right: 14rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #1f2329;
}

/* 第四行：两个快捷按钮 */
.quick-row {
  display: flex;
  margin-top: 24rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  height: 116rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(90, 160, 220, 0.1);
}

.quick-btn + .quick-btn {
  margin-left: 24rpx;
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.icon-blue {
  background: #e8f4ff;
}

.icon-orange {
  background: #fff1e6;
}

.quick-name {
  flex: 1;
  margin-left: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2329;
}

.quick-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #1f2329;
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
}

/* 第五行：功能网格（两排，一排5个） */
.func-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 16rpx 8rpx 4rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 28rpx rgba(90, 160, 220, 0.12);
}

.func-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
}

.func-name {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #333333;
  text-align: center;
}

/* 第六行：广告轮播图 */
.ad-swiper {
  margin-top: 24rpx;
  height: 200rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.ad-item {
  height: 200rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.ad-1 {
  background: linear-gradient(135deg, #5fb6f5 0%, #2f9de8 100%);
}

.ad-2 {
  background: linear-gradient(135deg, #9b8cff 0%, #6c5ce7 100%);
}

.ad-3 {
  background: linear-gradient(135deg, #ffb347 0%, #ff7e5f 100%);
}

.ad-emoji {
  font-size: 76rpx;
  margin-right: 32rpx;
}

.ad-title {
  font-size: 36rpx;
  font-weight: 800;
}

.ad-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

/* 第七行：订单列表 */
.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 32rpx 4rpx 20rpx;
}

.order-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2329;
}

.order-more {
  font-size: 24rpx;
  color: #8a97a5;
}

.list-state {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #8a97a5;
}

/* 订单卡片：与接单大厅一致 */
.order-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  min-height: calc((100vh - 100rpx) / 2.5 - 40rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(90, 160, 220, 0.1);
}

.order-card-hover { opacity: 0.85; }

.order-head { display: flex; align-items: center; gap: 16rpx; }

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: auto;
  min-width: 0;
}
.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.user-nickname {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #666;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deadline { display: flex; align-items: center; gap: 4rpx; font-size: 22rpx; color: #888; white-space: nowrap; }

.order-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  margin-top: 16rpx;
}

.order-item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.loc-row { display: flex; align-items: center; gap: 8rpx; margin-top: 10rpx; font-size: 24rpx; color: #888; }

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
}

.reward { display: flex; align-items: baseline; gap: 8rpx; }
.reward-label { font-size: 22rpx; color: #999; }
.order-price { color: #ff4d4f; font-size: 40rpx; font-weight: 700; }
.publish-time { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: #aaa; }
.order-actions { margin-top: 20rpx; }

.school-picker-hover {
  opacity: 0.8;
}