.top-bar {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 14rpx 8rpx 10rpx;
  background:
    radial-gradient(circle at 86% 12%, rgba(255, 236, 159, .8) 0 58rpx, transparent 60rpx),
    radial-gradient(circle at 10% 26%, rgba(255,255,255,.55) 0 36rpx, transparent 38rpx),
    linear-gradient(160deg, #93e7f5 0%, #b8eff6 66%, #eaf9fa 100%);
  overflow: hidden;
}

.school-picker {
  display: flex;
  align-items: center;
  height: 60rpx;
  padding: 0 26rpx;
  background: rgba(255, 255, 255, .92);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(21, 142, 177, .12);
  font-size: 23rpx;
  color: #1f2329;
}

.loc-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.school-name {
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.school-caret {
  margin-left: 10rpx;
  font-size: 20rpx;
  color: var(--brand-dark);
}

.school-picker-hover {
  opacity: 0.8;
}

.brand {
  margin: 28rpx 8rpx 4rpx;
  padding: 8rpx 16rpx;
  position: relative;
}

.brand-line1 {
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.12;
  letter-spacing: 3rpx;
  color: #111418;
}

.brand-line2 {
  margin-top: 6rpx;
  font-size: 43rpx;
  font-weight: 800;
  color: #217994;
  letter-spacing: 2rpx;
}

.notice {
  display: flex;
  align-items: center;
  height: 58rpx;
  margin: 12rpx 30rpx 0;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, .72);
  border: 1rpx solid rgba(21, 142, 177, .10);
  border-radius: 999rpx;
  color: #6b737a;
}

.notice-icon {
  font-size: 30rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.notice-text {
  font-size: 21rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-row {
  display: flex;
  margin-top: 28rpx;
  gap: 20rpx;
}

.quick-btn {
  flex: 1;
  display: flex;
  align-items: center;
  height: 128rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-radius: 26rpx;
  border-bottom: 3rpx solid #d8f5fb;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .04);
}

.quick-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.icon-blue {
  background: #dff6ff;
}

.icon-orange {
  background: #fff2e8;
}

.quick-name {
  flex: 1;
  margin-left: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #202429;
}

.quick-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #202326;
  color: #ffffff;
  font-size: 28rpx;
  text-align: center;
  line-height: 44rpx;
}

.func-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  padding: 20rpx 8rpx 10rpx;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .04);
}

.func-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.func-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.func-name {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #30343a;
  text-align: center;
}

.ad-swiper {
  margin-top: 24rpx;
  height: 200rpx;
  border-radius: 30rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .05);
}

.ad-item {
  height: 200rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
  color: #ffffff;
}

.ad-1 {
  background: linear-gradient(135deg, #5fb6f5 0%, #2f9de8 100%);
}

.ad-2 {
  background: linear-gradient(135deg, #9b8cff 0%, #6c5ce7 100%);
}

.ad-3 {
  background: linear-gradient(135deg, #ffb347 0%, #ff7e5f 100%);
}

.ad-emoji {
  font-size: 72rpx;
  margin-right: 28rpx;
}

.ad-title {
  font-size: 34rpx;
  font-weight: 800;
}

.ad-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 34rpx 4rpx 16rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111418;
}

.order-title::before {
  content: '';
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  margin-right: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  vertical-align: 4rpx;
}

.order-more {
  font-size: 23rpx;
  color: var(--muted);
}

.list-state {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

.order-card {
  margin: 0 0 20rpx;
  padding: 24rpx 24rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border-radius: 30rpx;
  border-bottom: 3rpx solid #d8f5fb;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .04);
}

.order-card-hover {
  opacity: 0.85;
}

.order-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: auto;
  min-width: 0;
}

.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #ff9174, #ffd7cc);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.user-nickname {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #82888d;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deadline {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 5rpx 10rpx;
  border-radius: 8rpx;
  background: #f4f6f7;
  font-size: 22rpx;
  color: #95999e;
  white-space: nowrap;
}

.order-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  margin-top: 16rpx;
}

.order-item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #252a2f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.loc-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8a8f94;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f4;
}

.reward {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.reward-label {
  font-size: 22rpx;
  color: var(--muted);
}

.order-price {
  color: #ff4b4b;
  font-size: 42rpx;
  font-weight: 800;
}

.publish-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #a6abb0;
}

.order-actions {
  margin-top: 18rpx;
}
/* Hero art decorations */
.brand {
  min-height: 204rpx;
}

.brand-eyebrow {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .55);
  color: #217994;
  font-size: 19rpx;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.brand-eyebrow, .brand-line1, .brand-line2 {
  position: relative;
  z-index: 2;
}

.hero-art {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  width: 300rpx;
  height: 180rpx;
  z-index: 1;
}

.sun {
  position: absolute;
  right: 16rpx;
  top: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 236, 159, .85);
}

.cloud {
  position: absolute;
  color: rgba(255, 255, 255, .9);
  font-size: 66rpx;
}

.cloud-a {
  left: 4rpx;
  top: 16rpx;
}

.cloud-b {
  right: 40rpx;
  top: 74rpx;
  transform: scale(.65);
}

.rider {
  position: absolute;
  right: 2rpx;
  bottom: 0;
  font-size: 104rpx;
  transform: scaleX(-1) rotate(-4deg);
}

.runner {
  position: absolute;
  right: 88rpx;
  bottom: 70rpx;
  font-size: 64rpx;
  transform: rotate(8deg);
}

/* Demo-style order card (shared with hall) */
.order-card {
  margin: 0 0 20rpx;
  padding: 24rpx 24rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  border-bottom: 3rpx solid #d8f5fb;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .035);
}

.task-head {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #ff9174, #ffd7cc);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-tag {
  flex-shrink: 0;
  padding: 5rpx 11rpx;
  border-radius: 6rpx;
  background: #dff7f3;
  color: #06a989;
  font-size: 21rpx;
}

.service-EXPRESS { background: #d8f6ff; color: #00aee0; }
.service-FOOD { background: #fff0d5; color: #e68a00; }
.service-SHOPPING { background: #efe4ff; color: #8750c7; }
.service-OTHER { background: #dff7f3; color: #06a989; }

.deadline {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  background: #f4f4f4;
  color: #95999e;
  font-size: 20rpx;
}

.status {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 600;
}

.status-OPEN { color: #ff694c; }
.status-PAYMENT_PENDING { color: #e68a00; }
.status-ACCEPTED { color: #06a989; }
.status-COMPLETION_PENDING { color: #92969a; }
.status-DONE { color: #34a853; }
.status-CANCELLED { color: #92969a; }

.task-copy {
  margin-top: 16rpx;
  color: #252a2f;
  font-size: 25rpx;
  line-height: 1.55;
}

.gender {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ff8fc2;
  color: #ffffff;
  font-size: 20rpx;
  vertical-align: 2rpx;
}

.gender.unlimited {
  background: #ef85ba;
}

.task-title {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #252a2f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666666;
}

.route {
  margin-top: 16rpx;
}

.route-row {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  color: #3d4349;
  font-size: 23rpx;
}

.route-icon {
  width: 50rpx;
  margin-right: 8rpx;
  font-size: 29rpx;
  text-align: center;
}

.task-foot {
  min-height: 62rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.reward {
  color: #ff3d3d;
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.reward-mark {
  margin-right: 9rpx;
  padding: 3rpx 7rpx;
  border-radius: 4rpx;
  background: #ffe3e3;
  font-size: 19rpx;
}

.created {
  margin-left: auto;
  color: #999ea3;
  font-size: 20rpx;
}

.accept-button {
  width: 176rpx;
  height: 60rpx;
  margin: 0 0 0 18rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #050505;
  color: #d9ff40;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.accept-button.mine {
  background: #eff1f2;
  color: #7b8085;
}

.accept-button.active-button {
  background: #202224;
  color: #ffffff;
}

.accept-button.disabled {
  background: #eff1f2;
  color: #a0a4a8;
}

/* Demo-style service panel (feature cards + 5-column grid) */
.service-panel {
  margin: 20rpx 0 0;
  padding: 24rpx 22rpx 22rpx;
  position: relative;
  z-index: 4;
}

.feature-row {
  display: flex;
  gap: 20rpx;
}

.feature-card {
  flex: 1;
  height: 168rpx;
  padding: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, .8);
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
}

.feature-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.feature-action {
  display: inline-block;
  margin-top: 14rpx;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  background: #22323a;
  color: #ffffff;
  font-size: 20rpx;
}

.feature-icon {
  font-size: 82rpx;
  transform: rotate(-8deg);
}

.service-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  row-gap: 24rpx;
}

.service-cell {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #202429;
  font-size: 22rpx;
}

.service-icon {
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 10rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}