.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 140rpx;
}

.zone {
  padding: 24rpx 32rpx;
  border-bottom: 16rpx solid #f7f8fa;
}

/* 区域一：UI 展示 */
.zone-ui {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: none;
  background: linear-gradient(180deg, #ffebeb 0%, #ffffff 100%);
}

.zone-icon {
  font-size: 96rpx;
}

.zone-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-top: 16rpx;
}

.zone-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

/* 区域二：任务内容 */
.zone-base {
  padding: 8rpx 32rpx;
}

.zone-head {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.field-area {
  align-items: flex-start;
}

.label {
  width: 240rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333333;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
}

.textarea {
  flex: 1;
  height: 140rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.attach-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 区域三：性别限制 */
.zone-gender {
  padding: 8rpx 32rpx;
}

.gender-row {
  display: flex;
}

.gender-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  margin-right: 20rpx;
  background: #f7f8fa;
  color: #666666;
  border: 2rpx solid #f2f3f5;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.gender-btn:last-child {
  margin-right: 0;
}

.gender-btn.active {
  background: #ffebeb;
  color: #ff4d4f;
  border-color: #ff4d4f;
  font-weight: 600;
}

/* 区域四：附件 */
.zone-attach {
  padding: 8rpx 32rpx;
}

.attach-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.attach-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.attach-item {
  position: relative;
  margin-left: 16rpx;
}

.attach-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
}

.attach-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  font-size: 20rpx;
}

.attach-add {
  width: 96rpx;
  height: 96rpx;
  margin-left: 16rpx;
  border: 2rpx dashed #cccccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #bbbbbb;
}

/* 区域五：赏金 */
.zone-reward {
  border-bottom: none;
}

.qty-stepper {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #ffebeb;
  color: #ff4d4f;
  border-radius: 50%;
  font-size: 32rpx;
}

.step-btn.disabled {
  background: #f2f3f5;
  color: #cccccc;
}

.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333333;
}

/* 底部立即下单 */
.order-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-top: 1rpx solid #f2f3f5;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-total {
  font-size: 28rpx;
  color: #333333;
}

.total-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b2f;
}

.submit-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #ff4d4f;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  background: #ffb3b4;
}
