<view class="page">
  <view class="hint">以下订单还未支付，可继续支付或取消订单</view>

  <view class="list-state" wx:if="{{loading}}">加载中...</view>
  <view class="list-state" wx:if="{{!loading && orders.length === 0}}">暂无待支付订单</view>

  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-top">
      <view class="order-title">{{item.title}}</view>
      <text class="order-status" style="color: {{item.tagColor}};">{{item.statusLabel}}</text>
    </view>
    <view class="order-desc" wx:if="{{item.description}}">{{item.description}}</view>
    <view class="order-meta">
      <text class="order-time">🕐 {{item.timeText}}</text>
      <text class="order-reward">赏金 ¥{{item.reward}}</text>
    </view>
    <view class="order-actions">
      <van-button size="mini" plain type="danger" data-id="{{item.id}}" bindtap="onCancel">取消订单</van-button>
      <van-button size="mini" type="primary" data-id="{{item.id}}" bindtap="onPay">去支付</van-button>
    </view>
  </view>
</view>