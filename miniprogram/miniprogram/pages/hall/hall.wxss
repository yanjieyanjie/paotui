.tabs {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  background: #ffffff;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 14rpx 0;
  border-radius: 32rpx;
}

.tab.active {
  background: #f0faf5;
  color: #07c160;
  font-weight: 600;
}

.order-card {
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  min-height: calc((100vh - 100rpx) / 2.5 - 40rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.order-card-hover { opacity: 0.85; }

.order-head { display: flex; align-items: center; gap: 16rpx; }

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: auto;
  min-width: 0;
}
.user-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #07c160;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.user-nickname {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #666;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deadline { display: flex; align-items: center; gap: 4rpx; font-size: 22rpx; color: #888; white-space: nowrap; }

.order-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  margin-top: 16rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.loc-row { display: flex; align-items: center; gap: 8rpx; margin-top: 10rpx; font-size: 24rpx; color: #888; }

.order-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f2f3f5;
}

.reward { display: flex; align-items: baseline; gap: 8rpx; }
.reward-label { font-size: 22rpx; color: #999; }
.order-price { color: #ff4d4f; font-size: 40rpx; font-weight: 700; }
.publish-time { display: flex; align-items: center; gap: 6rpx; font-size: 22rpx; color: #aaa; }
.order-actions { margin-top: 20rpx; }

.list-footer { text-align: center; color: #bbb; font-size: 24rpx; padding: 24rpx; }