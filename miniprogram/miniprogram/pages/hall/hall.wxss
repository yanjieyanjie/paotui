.tabs {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  background: #ffffff;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f2f3f5;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 14rpx 0;
  border-radius: 32rpx;
}

.tab.active {
  background: #eafaf7;
  color: #06a989;
  font-weight: 600;
}

.order-card {
  margin: 0 0 20rpx;
  padding: 24rpx 24rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
  border-radius: 28rpx;
  border-bottom: 3rpx solid #d8f5fb;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .035);
}

.order-card-hover {
  opacity: 0.85;
}

.task-head {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: linear-gradient(145deg, #ff9174, #ffd7cc);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-tag {
  flex-shrink: 0;
  padding: 5rpx 11rpx;
  border-radius: 6rpx;
  background: #dff7f3;
  color: #06a989;
  font-size: 21rpx;
}

.service-EXPRESS { background: #d8f6ff; color: #00aee0; }
.service-FOOD { background: #fff0d5; color: #e68a00; }
.service-SHOPPING { background: #efe4ff; color: #8750c7; }
.service-OTHER { background: #dff7f3; color: #06a989; }

.deadline {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 5rpx 10rpx;
  border-radius: 6rpx;
  background: #f4f4f4;
  color: #95999e;
  font-size: 20rpx;
}

.status {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 21rpx;
  font-weight: 600;
}

.status-OPEN { color: #ff694c; }
.status-PAYMENT_PENDING { color: #e68a00; }
.status-ACCEPTED { color: #06a989; }
.status-COMPLETION_PENDING { color: #92969a; }
.status-DONE { color: #34a853; }
.status-CANCELLED { color: #92969a; }

.task-copy {
  margin-top: 16rpx;
  color: #252a2f;
  font-size: 25rpx;
  line-height: 1.55;
}

.gender {
  display: inline-flex;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ff8fc2;
  color: #ffffff;
  font-size: 20rpx;
  vertical-align: 2rpx;
}

.gender.unlimited {
  background: #ef85ba;
}

.task-title {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #252a2f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666666;
}

.route {
  margin-top: 16rpx;
}

.route-row {
  min-height: 46rpx;
  display: flex;
  align-items: center;
  color: #3d4349;
  font-size: 23rpx;
}

.route-icon {
  width: 50rpx;
  margin-right: 8rpx;
  font-size: 29rpx;
  text-align: center;
}

.task-foot {
  min-height: 62rpx;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
}

.reward {
  color: #ff3d3d;
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.reward-mark {
  margin-right: 9rpx;
  padding: 3rpx 7rpx;
  border-radius: 4rpx;
  background: #ffe3e3;
  font-size: 19rpx;
}

.created {
  margin-left: auto;
  color: #999ea3;
  font-size: 20rpx;
}

.accept-button {
  width: 176rpx;
  height: 60rpx;
  margin: 0 0 0 18rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #050505;
  color: #d9ff40;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.accept-button.mine {
  background: #eff1f2;
  color: #7b8085;
}

.accept-button.active-button {
  background: #202224;
  color: #ffffff;
}

.accept-button.disabled {
  background: #eff1f2;
  color: #a0a4a8;
}

.list-footer {
  text-align: center;
  color: #bbb;
  font-size: 24rpx;
  padding: 24rpx;
}