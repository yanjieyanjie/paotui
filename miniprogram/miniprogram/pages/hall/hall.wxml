<view class="page">
  <!-- 顶部状态标签 -->
  <view class="tabs">
    <view class="tab {{tabIndex === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-index="{{index}}" bindtap="onTabChange">{{item}}</view>
  </view>

  <view class="card order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap" hover-class="order-card-hover">
    <view class="order-head">
      <view class="user-info">
        <image wx:if="{{item.avatarUrl}}" class="user-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:if="{{!item.avatarUrl}}" class="user-avatar">{{item.avatarText}}</view>
        <text class="user-nickname">{{item.creatorName}}</text>
      </view>
      <van-tag color="{{item.tagColor}}" plain>{{item.typeLabel}}</van-tag>
      <view class="deadline">
        <van-icon name="clock-o" size="26" color="#999" />
        <text class="deadline-text">截止 {{item.deadlineText}}</text>
      </view>
      <van-tag type="primary" plain>{{item.statusLabel}}</van-tag>
    </view>
    <view class="order-body">
      <view class="order-title">{{item.title}}</view>
      <view class="order-desc" wx:if="{{item.description}}">{{item.description}}</view>
      <view class="loc-row" wx:if="{{item.pickup}}">
        <van-icon name="location-o" size="28" color="#999" />
        <text>{{item.pickup}}</text>
      </view>
      <view class="loc-row" wx:if="{{item.delivery}}">
        <van-icon name="flag-o" size="28" color="#999" />
        <text>{{item.delivery}}</text>
      </view>
    </view>
    <view class="order-foot">
      <view class="reward">
        <text class="reward-label">赏金</text>
        <text class="order-price">¥{{item.reward}}</text>
      </view>
      <view class="publish-time">
        <van-icon name="clock-o" size="24" color="#aaa" />
        <text>发布时间 {{item.timeText}}</text>
      </view>
    </view>
    <view class="order-actions" wx:if="{{item.showAccept}}">
      <van-button size="small" type="primary" round block data-id="{{item.id}}" catchtap="onAccept">抢单</van-button>
    </view>
    <view class="order-actions" wx:if="{{item.showWithdraw}}">
      <van-button size="small" type="danger" plain round block data-id="{{item.id}}" catchtap="onCancel">撤回任务</van-button>
    </view>
    <view class="order-actions" wx:if="{{item.status === 'ACCEPTED'}}">
      <van-button size="small" type="warning" round block data-id="{{item.id}}" catchtap="onDone">确认完成</van-button>
    </view>
    <view class="order-actions" wx:if="{{item.status === 'COMPLETION_PENDING'}}">
      <van-button size="small" round block disabled>等待确认</van-button>
    </view>
  </view>

  <view class="list-footer" wx:if="{{orders.length > 0}}">
    <text wx:if="{{finished}}">— 没有更多了 —</text>
    <van-loading wx:else size="20" text="加载中..." />
  </view>

  <van-empty wx:if="{{!loading && orders.length === 0}}" description="暂无相关任务" />
</view>