<view class="page">
  <view class="msg-header" wx:if="{{messages.length > 0}}">
    <text class="msg-header-title">全部消息</text>
    <text class="msg-header-count">{{unreadCount}} 条未读</text>
  </view>

  <view
    class="card msg-card {{item.isRead ? '' : 'unread'}}"
    wx:for="{{messages}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="onMessageTap"
  >
    <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
    <view class="msg-text">{{item.content}}</view>
    <view class="msg-time">{{item.timeText}}</view>
  </view>

  <van-empty wx:if="{{!loading && messages.length === 0}}" description="暂无消息" />
</view>