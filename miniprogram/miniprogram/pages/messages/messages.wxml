<view class="page">
  <van-tabs active="{{activeTab}}" bind:change="onTabChange">
    <van-tab title="{{chatUnread > 0 ? '聊天 ' + chatUnread : '聊天'}}">
      <view wx:if="{{conversations.length > 0}}">
        <view
          class="card conv-card"
          wx:for="{{conversations}}"
          wx:key="key"
          data-id="{{item.orderId}}"
          data-otherid="{{item.otherUserId}}"
          bindtap="onConversationTap"
          hover-class="conv-hover"
        >
          <view class="conv-avatar">
            <image wx:if="{{item.otherAvatar}}" class="avatar-img" src="{{item.otherAvatar}}" mode="aspectFill" />
            <view wx:else class="avatar-fallback">{{item.avatarText}}</view>
          </view>
          <view class="conv-main">
            <view class="conv-top">
              <text class="conv-name">{{item.otherNickname}}</text>
              <text class="conv-time">{{item.timeText}}</text>
            </view>
            <view class="conv-last">{{item.lastContent}}</view>
            <view class="conv-order">订单：{{item.orderTitle}}</view>
          </view>
          <view class="conv-badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view>
        </view>
      </view>
      <van-empty wx:if="{{!loading && conversations.length === 0}}" description="暂无聊天" />
    </van-tab>

    <van-tab title="{{notifUnread > 0 ? '通知 ' + notifUnread : '通知'}}">
      <view wx:if="{{notifications.length > 0}}">
        <view class="msg-header">
          <text class="msg-header-title">全部消息</text>
          <text class="msg-header-count">{{notifUnread}} 条未读</text>
        </view>
        <view
          class="card msg-card {{item.isRead ? '' : 'unread'}}"
          wx:for="{{notifications}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onMessageTap"
        >
          <view class="msg-dot" wx:if="{{!item.isRead}}"></view>
          <view class="msg-text">{{item.content}}</view>
          <view class="msg-time">{{item.timeText}}</view>
        </view>
      </view>
      <van-empty wx:if="{{!loading && notifications.length === 0}}" description="暂无通知" />
    </van-tab>
  </van-tabs>
</view>