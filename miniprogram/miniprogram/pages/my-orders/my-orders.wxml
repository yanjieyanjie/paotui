<view class="page">
  <!-- 顶部五个状态按钮 -->
  <view class="tabs">
    <view class="tab {{currentTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="*this" data-index="{{index}}" bindtap="onTabTap">{{item}}</view>
  </view>

  <view class="list-state" wx:if="{{loading}}">加载中...</view>
  <view class="list-state" wx:if="{{!loading && orders.length === 0}}">暂无{{tabs[currentTab]}}订单</view>

  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-top">
      <view class="order-title">{{item.title}}</view>
      <text class="order-status" style="color: {{item.tagColor}};">{{item.statusLabel}}</text>
    </view>
    <view class="order-desc" wx:if="{{item.description}}">{{item.description}}</view>
    <view class="order-meta">
      <text class="order-time">🕐 {{item.timeText}}</text>
      <text class="order-reward">赏金 ¥{{item.reward}}</text>
    </view>
    <view class="order-actions" wx:if="{{item.status === 'PAYMENT_PENDING'}}">
      <van-button size="mini" plain type="danger" data-id="{{item.id}}" bindtap="onCancel">取消订单</van-button>
      <van-button size="mini" type="primary" data-id="{{item.id}}" bindtap="onPay">去支付</van-button>
    </view>
    <view class="order-actions" wx:if="{{item.status === 'ACCEPTED'}}">
      <van-button size="mini" type="success" data-id="{{item.id}}" bindtap="onConfirm">确认完成</van-button>
    </view>
    <view class="order-actions" wx:if="{{item.status === 'COMPLETION_PENDING'}}">
      <text class="order-hint">骑手已提交完成，请确认</text>
      <van-button size="mini" type="success" data-id="{{item.id}}" bindtap="onConfirm">确认完成</van-button>
    </view>
  </view>
</view>