.page {
  min-height: 100vh;
  background: #f7f8fa;
}

.tabs {
  position: sticky;
  top: 0;
  display: flex;
  background: #ffffff;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #f2f3f5;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666666;
  padding: 14rpx 0;
  border-radius: 32rpx;
}

.tab.active {
  background: #fff7f0;
  color: #ff7a2f;
  font-weight: 600;
}

.list-state {
  text-align: center;
  color: #999999;
  padding: 120rpx 0;
  font-size: 28rpx;
}

.order-card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.order-status {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.order-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #666666;
}

.order-meta {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 24rpx;
  color: #999999;
}

.order-reward {
  color: #ff6b2f;
  font-weight: 600;
}
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}