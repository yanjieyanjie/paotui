<view class="page">
  <view class="intro card">
    <view class="intro-icon">📣</view>
    <view class="intro-title">成为推广员</view>
    <view class="intro-desc">推广平台给身边的同学，成功邀请可获得专属奖励。</view>
  </view>

  <view class="form card">
    <view class="form-item">
      <text class="form-label">姓名</text>
      <input class="form-input" placeholder="请输入真实姓名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>
    <view class="form-item">
      <text class="form-label">备注</text>
      <input class="form-input" placeholder="推广渠道/邀请码（选填）" value="{{remark}}" bindinput="onRemarkInput" />
    </view>
  </view>

  <button class="submit-btn" bindtap="onSubmit" disabled="{{submitting}}">提交申请</button>
</view>