<view class="profile-page page-with-tab">
  <view class="profile-head safe-top">
    <view class="nav-bar profile-nav">
      <view class="head-dots">••</view>
      <view class="wechat-capsule"><text>•••</text><view class="capsule-line"></view><text>◉</text></view>
    </view>

    <view class="user-row" bindtap="onEditProfile">
      <view class="profile-avatar">
        <image wx:if="{{user && user.avatar}}" src="{{user.avatar}}" mode="aspectFill" class="avatar-img"></image>
        <text wx:else>{{avatarChar}}</text>
      </view>
      <view class="user-copy">
        <text class="hello">{{user.nickname || avatarChar}}</text>
        <view class="user-id">ID: {{user.id || ''}}</view>
        <text class="profile-summary">{{user.phone || user.major || '点击完善个人资料'}}</text>
      </view>
      <view class="edit-icon">✎</view>
    </view>

    <view class="identity-row">
      <text>身份：{{identityOptions[identityIndex].label}}</text>
      <picker range="{{identityOptions}}" range-key="label" value="{{identityIndex}}" bindchange="onIdentityChange">
        <button>♙ 切换身份 ⌄</button>
      </picker>
    </view>
  </view>

  <view class="profile-body">
    <view class="stat-card card">
      <view wx:for="{{publisherWallet}}" wx:key="key">
        <text>{{item.value}}</text>
        <text>{{item.label}}</text>
      </view>
    </view>

    <view class="orders-card card">
      <text class="card-title">我的订单</text>
      <view class="order-entry-row">
        <view class="order-entry" wx:for="{{orderTabs}}" wx:key="key" data-tab="{{item.tab}}" bindtap="onOrderTabTap">
          <view class="order-icon">{{item.icon}}</view>
          <text>{{item.name}}</text>
        </view>
      </view>
    </view>

    <view class="promo-row" wx:if="{{identityIndex === 0}}">
      <view class="promo-card runner-card" data-page="runner" bindtap="onApplyTap">
        <view><text>成为接单员</text><text>去申请 ›</text></view><text class="promo-art">💰</text>
      </view>
      <view class="promo-card promoter-card" data-page="promoter" bindtap="onApplyTap">
        <view><text>成为推广员</text><text>去申请 ›</text></view><text class="promo-art">📣</text>
      </view>
    </view>

    <view class="menu-card card">
      <text class="card-title">我的服务</text>
      <view class="menu-row" wx:for="{{menus}}" wx:key="title" data-title="{{item.title}}" bindtap="onMenuTap">
        <view class="menu-icon"><van-icon name="{{item.icon}}" size="26" color="#7ca535" /></view>
        <text>{{item.title}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <view class="version">校园跑腿 · v0.1.0</view>
  </view>
</view>