.profile-page {
  min-height: 100vh;
  background: #f6f6f6;
}

.profile-head {
  height: 368rpx;
  background:
    radial-gradient(circle at 17% 13%, rgba(255,255,255,.6) 0 8rpx, transparent 10rpx),
    linear-gradient(150deg, #c5fb83 0%, #e3ffb7 62%, #f5ffe5 100%);
}

.profile-nav {
  height: 91rpx;
}

.head-dots {
  color: #5f8b34;
  font-size: 28rpx;
  letter-spacing: 12rpx;
}

.user-row {
  height: 152rpx;
  padding: 10rpx 30rpx;
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  border: 5rpx solid rgba(255,255,255,.82);
  border-radius: 50%;
  background: linear-gradient(145deg, #f1b8ff, #ffdee7);
  color: #8c4e9c;
  font-size: 42rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-copy {
  min-width: 0;
  flex: 1;
  padding-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.hello {
  font-size: 35rpx;
  font-weight: 800;
}

.user-id {
  margin-top: 7rpx;
  color: #75856a;
  font-size: 21rpx;
}

.user-id text {
  margin-left: 6rpx;
}

.profile-summary {
  max-width: 420rpx;
  margin-top: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #78886e;
  font-size: 19rpx;
}

.edit-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.38);
  display: flex;
  align-items: center;
  justify-content: center;
}

.identity-row {
  height: 74rpx;
  margin: 0 28rpx;
  padding: 0 18rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: rgba(188, 240, 89, .58);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 23rpx;
}

.identity-row button {
  height: 50rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.85);
  box-shadow: 0 4rpx 12rpx rgba(93, 130, 51, .12);
  font-size: 21rpx;
  line-height: 50rpx;
}

.profile-body {
  margin-top: -51rpx;
  padding: 0 28rpx 50rpx;
  position: relative;
  z-index: 2;
}

.stat-card {
  height: 136rpx;
  padding: 14rpx 24rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  align-items: center;
}

.stat-card > view {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-card > view text:first-child {
  font-size: 34rpx;
  font-weight: 800;
}

.stat-card > view text:last-child {
  margin-top: 5rpx;
  color: #747a7f;
  font-size: 21rpx;
}

.orders-card {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .05);
}

.card-title {
  font-size: 27rpx;
  font-weight: 700;
}

.order-entry-row {
  margin-top: 23rpx;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
}

.order-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #474c51;
  font-size: 20rpx;
}

.order-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 7rpx;
  border-radius: 12rpx;
  background: #303437;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.promo-row {
  margin-top: 20rpx;
  display: flex;
  gap: 18rpx;
}

.promo-card {
  flex: 1;
  height: 118rpx;
  padding: 20rpx 18rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
}

.runner-card { background: linear-gradient(120deg, #d9ff8d, #f5ffe5); }
.promoter-card { background: linear-gradient(120deg, #ffe77c, #fff9cf); }

.promo-card > view {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.promo-card > view text:first-child {
  font-size: 25rpx;
  font-weight: 700;
}

.promo-card > view text:last-child {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 4rpx 11rpx;
  border-radius: 999rpx;
  background: #202326;
  color: #ffffff;
  font-size: 17rpx;
}

.promo-art {
  font-size: 53rpx;
}

.menu-card {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 13rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(34, 45, 54, .05);
}

.menu-row {
  height: 82rpx;
  display: flex;
  align-items: center;
  color: #2e3337;
  font-size: 24rpx;
}

.menu-icon {
  width: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-arrow {
  margin-left: auto;
  color: #a1a5a9;
  font-size: 30rpx;
}

.version {
  padding: 70rpx 0 30rpx;
  color: #a1a5a9;
  text-align: center;
  font-size: 21rpx;
}