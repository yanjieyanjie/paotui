.page {
  background: #ffffff;
  min-height: 100vh;
}

.list-wrap {
  padding-bottom: 160rpx;
}

.addr-card {
  background: #ffffff;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.addr-head {
  display: flex;
  align-items: center;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.addr-phone {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #666666;
}

.default-tag {
  margin-left: auto;
  font-size: 22rpx;
  color: #ff7a2f;
  border: 1rpx solid #ff7a2f;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.addr-text {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #666666;
}

.addr-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
  border-top: 1rpx solid #f2f3f5;
  padding-top: 16rpx;
}

.action-link {
  font-size: 26rpx;
  color: #666666;
  margin-left: 40rpx;
}

.action-link.danger {
  color: #e64340;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999999;
}

.empty-title {
  font-size: 30rpx;
}

.empty-tip {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #bbbbbb;
}

.empty-add {
  margin-top: 40rpx;
  display: inline-block;
  background: #ffffff;
  color: #ff7a2f;
  border: 1rpx solid #ff7a2f;
  border-radius: 40rpx;
  font-size: 28rpx;
  line-height: 68rpx;
  padding: 0 48rpx;
}

.empty-add::after {
  border: none;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.add-btn {
  background: #ff7a2f;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
}

.add-btn::after {
  border: none;
}

.add-btn[disabled] {
  background: #ffd1b3;
  color: #ffffff;
}

.form-top {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}

.back-link {
  font-size: 28rpx;
  color: #666666;
  padding-right: 24rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
}

.form-card {
  margin: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
}

.form-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row switch {
  margin-left: auto;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.picker-value.placeholder {
  color: #bbbbbb;
}