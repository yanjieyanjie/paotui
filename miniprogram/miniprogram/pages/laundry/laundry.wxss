.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: 140rpx;
}

.zone {
  padding: 24rpx 32rpx;
  border-bottom: 16rpx solid #f7f8fa;
}

/* 区域一：UI 展示 */
.zone-ui {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: none;
  background: linear-gradient(180deg, #fff7f0 0%, #ffffff 100%);
}

.zone-icon {
  font-size: 96rpx;
}

.zone-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-top: 16rpx;
}

.zone-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

/* 区域二：所在信息（已移除） */
.zone-base {
  padding: 8rpx 32rpx;
}

.zone-head {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.field-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f2f3f5;
}

.label {
  font-size: 28rpx;
  color: #333333;
}

.input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
}

/* 常用提示标签 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
}

.tag-chip {
  padding: 8rpx 22rpx;
  margin: 0 12rpx 12rpx 0;
  background: #f7f8fa;
  color: #666666;
  border: 1rpx solid #f2f3f5;
  border-radius: 28rpx;
  font-size: 24rpx;
}

.tag-chip:active {
  background: #fff7f0;
  color: #ff7a2f;
  border-color: #ff7a2f;
}

/* 区域三：放置衣物照片 */
.zone-photo {
  padding: 8rpx 32rpx;
}

.attach-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
}

.attach-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.attach-item {
  position: relative;
  margin-left: 16rpx;
}

.attach-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  background: #f2f3f5;
}

.attach-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #ffffff;
  border-radius: 50%;
  font-size: 20rpx;
}

.attach-add {
  width: 96rpx;
  height: 96rpx;
  margin-left: 16rpx;
  border: 2rpx dashed #cccccc;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #bbbbbb;
}

.attach-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 12rpx;
}

/* 区域四：选择洗衣服务 */
.zone-wash {
  border-bottom: none;
}

.size-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid #f2f3f5;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.size-info {
  flex: 1;
}

.size-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.size-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.size-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff6b2f;
  margin-top: 8rpx;
}

.qty-stepper {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background: #fff7f0;
  color: #ff7a2f;
  border-radius: 50%;
  font-size: 32rpx;
}

.step-btn.disabled {
  background: #f2f3f5;
  color: #cccccc;
}

.step-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 30rpx;
  color: #333333;
}

/* 底部立即下单 */
.order-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-top: 1rpx solid #f2f3f5;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.order-total {
  font-size: 28rpx;
  color: #333333;
}

.total-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff6b2f;
}

.submit-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #ff7a2f;
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn.disabled {
  background: #ffd1b3;
}
/* 收货地址 */
.zone-addr {
  padding: 8rpx 32rpx;
}

.addr-card {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.addr-head {
  display: flex;
  align-items: center;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.addr-phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.default-tag {
  margin-left: 16rpx;
  font-size: 20rpx;
  color: #ff7a2f;
  border: 1rpx solid #ff7a2f;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.addr-arrow {
  margin-left: auto;
  font-size: 22rpx;
  color: #999999;
}

.addr-text {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
}

.addr-summary {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

.addr-tip {
  font-size: 22rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 收货地址选择弹层 */
.addr-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
}

.addr-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.sheet-head {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  padding-bottom: 16rpx;
}

.sheet-list {
  max-height: 50vh;
}

.sheet-item {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.sheet-item-main {
  flex: 1;
}

.sheet-item-head {
  display: flex;
  align-items: center;
}

.sheet-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.sheet-phone {
  margin-left: 16rpx;
  font-size: 26rpx;
  color: #666666;
}

.sheet-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #666666;
  line-height: 1.4;
}

.sheet-check {
  margin-left: 16rpx;
  color: #ff7a2f;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet-empty {
  text-align: center;
  padding: 48rpx 0;
  color: #999999;
}

.sheet-empty-title {
  font-size: 28rpx;
}

.sheet-empty-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #bbbbbb;
}

.sheet-add {
  margin-top: 20rpx;
  background: #ff7a2f;
  color: #ffffff;
  text-align: center;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.sheet-cancel {
  margin-top: 16rpx;
  text-align: center;
  line-height: 80rpx;
  color: #666666;
  font-size: 28rpx;
}